# Where the API lives. The website forwards /api to this address, so the browser only ever talks to the website.
API_ORIGIN=http://localhost:4000
# Must match the API's SESSION_COOKIE_NAME.
# SESSION_COOKIE_NAME=pf_session

# Private admin address. Set to something long and hard to guess, then open /<this value> while signed in as an
# administrator. With it set, /admin does not exist. Change it and redeploy to move the address.
# ADMIN_SLUG=desk-7f3k9q2m
# Shown on the privacy page.
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
