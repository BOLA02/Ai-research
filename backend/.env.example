DATABASE_URL=postgresql://postgres:123456@localhost:5432/projectforge
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=pf_session
SEED_USER_EMAIL=student@projectforge.local
SEED_USER_PASSWORD=replace-with-a-strong-development-password
SEED_USER_FIRST_NAME=ProjectForge
SEED_USER_LAST_NAME=Student

# Writing coach (optional). Leave ANTHROPIC_API_KEY unset to switch the coach off.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_DAILY_LIMIT=20
# AI_BURST_PER_MINUTE=6

# Production (set these on the host, not in a file)
# NODE_ENV=production
# FRONTEND_URL=https://your-app.vercel.app   (required in production)
# TRUST_PROXY=1                              (Railway puts one proxy in front of the API)

# Password-reset email through Resend (https://resend.com). With no key the link is printed to the server log.
# RESEND_API_KEY=
# MAIL_FROM=ProjectForge <noreply@your-domain.com>
# PASSWORD_RESET_TTL_MINUTES=60

# Figure images on Cloudinary (https://cloudinary.com). Set all three to store pictures there;
# leave them out and pictures are kept in the database (3 MB each).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
