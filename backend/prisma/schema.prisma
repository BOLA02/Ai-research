generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum ProjectMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum SourceType {
  BOOK
  BOOK_CHAPTER
  JOURNAL
  CONFERENCE
  WEBSITE
  THESIS
  REPORT
  STANDARD
  PATENT
  OTHER
}

enum ProjectDocumentType {
  COVER_PAGE
  TITLE_PAGE
  CERTIFICATION
  APPROVAL_PAGE
  FLY_LEAF
  LIST_OF_SYMBOLS_ABBREVIATIONS
  DECLARATION
  DEDICATION
  ACKNOWLEDGEMENT
  ABSTRACT
  TABLE_OF_CONTENTS
  LIST_OF_FIGURES
  LIST_OF_TABLES
  APPENDIX
  CUSTOM
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  firstName    String          @db.VarChar(100)
  lastName     String          @db.VarChar(100)
  email        String          @unique @db.VarChar(320)
  passwordHash String
  role         UserRole        @default(STUDENT)
  isActive     Boolean         @default(true)
  experienceLevel String?      @db.VarChar(20)
  onboardedAt  DateTime?       @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)
  projects     Project[]       @relation("ProjectOwner")
  memberships  ProjectMember[]
  sessions     Session[]
  aiUsage      AiUsage[]
  passwordResets PasswordReset[]
  activity     ActivityLog[]

  @@index([email, isActive])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique @db.Char(64)
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id             String            @id @default(uuid()) @db.Uuid
  title          String            @db.VarChar(500)
  institution    String?           @db.VarChar(255)
  department     String?           @db.VarChar(255)
  programme      String?           @db.VarChar(255)
  projectType    String?           @db.VarChar(100)
  referenceStyle String?           @db.VarChar(30)
  templateId     String?           @db.VarChar(60)
  studentName          String?     @db.VarChar(200)
  registrationNumber   String?     @db.VarChar(60)
  supervisorNames      String?     @db.VarChar(500)
  coordinatorName      String?     @db.VarChar(200)
  hodName              String?     @db.VarChar(200)
  externalExaminerName String?     @db.VarChar(200)
  school               String?     @db.VarChar(200)
  college              String?     @db.VarChar(200)
  graduationYear       Int?
  ownerId        String            @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  owner          User              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  documents      ProjectDocument[]
  chapters       Chapter[]
  sources        Source[]
  figures        Figure[]
  tables         ReportTable[]
  calculations   Calculation[]

  @@index([ownerId])
}

model ProjectDocument {
  id        String              @id @default(uuid()) @db.Uuid
  projectId String              @db.Uuid
  type      ProjectDocumentType
  title     String              @db.VarChar(500)
  content   String              @default("")
  position  Int                 @default(0)
  isEnabled Boolean             @default(true)
  numbering String              @default("roman") @db.VarChar(10)
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @db.Timestamptz(6)
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
}

model Chapter {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @db.Uuid
  number    Int
  title     String    @db.VarChar(500)
  templateKey String?  @db.VarChar(60)
  position  Int
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sections  Section[]

  @@unique([projectId, number])
  @@index([projectId, position])
}

model Section {
  id              String    @id @default(uuid()) @db.Uuid
  chapterId       String    @db.Uuid
  parentSectionId String?   @db.Uuid
  title           String    @db.VarChar(500)
  templateKey     String?   @db.VarChar(60)
  content         String    @default("")
  position        Int
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  chapter         Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  parent          Section?  @relation("SectionHierarchy", fields: [parentSectionId], references: [id], onDelete: Cascade)
  children        Section[] @relation("SectionHierarchy")
  figures         Figure[]
  tables          ReportTable[]
  calculations    Calculation[]

  @@index([chapterId, position])
  @@index([parentSectionId])
}

model ProjectMember {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @db.Uuid
  userId    String            @db.Uuid
  role      ProjectMemberRole
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Source {
  id             String     @id @default(uuid()) @db.Uuid
  projectId      String     @db.Uuid
  citeKey        String     @db.VarChar(60)
  type           SourceType
  authors        Json       @default("[]")
  editors        Json       @default("[]")
  title          String     @db.VarChar(1000)
  containerTitle String?    @db.VarChar(500)
  year           Int?
  month          Int?
  day            Int?
  volume         String?    @db.VarChar(30)
  issue          String?    @db.VarChar(30)
  pages          String?    @db.VarChar(40)
  edition        String?    @db.VarChar(30)
  publisher      String?    @db.VarChar(300)
  place          String?    @db.VarChar(200)
  institution    String?    @db.VarChar(300)
  degree         String?    @db.VarChar(100)
  number         String?    @db.VarChar(100)
  url            String?    @db.VarChar(2000)
  doi            String?    @db.VarChar(200)
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(6)
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, citeKey])
  @@index([projectId])
}

model Figure {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  sectionId  String?  @db.Uuid
  label      String   @db.VarChar(60)
  caption    String   @db.VarChar(1000)
  sourceNote String?  @db.VarChar(1000)
  isOriginal Boolean  @default(true)
  altText    String?  @db.VarChar(500)
  imageData  Bytes?
  // Set when the picture lives on Cloudinary instead of in the database.
  imageUrl   String?  @db.VarChar(500)
  imagePublicId String? @db.VarChar(200)
  mimeType   String?  @db.VarChar(60)
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section    Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([projectId, label])
  @@index([projectId])
  @@index([sectionId])
}

model ReportTable {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  sectionId  String?  @db.Uuid
  label      String   @db.VarChar(60)
  caption    String   @db.VarChar(1000)
  sourceNote String?  @db.VarChar(1000)
  columns    Json     @default("[]")
  rows       Json     @default("[]")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section    Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([projectId, label])
  @@index([projectId])
  @@index([sectionId])
}

/// How many writing-coach reviews a student has used on a given day (UTC).
model AiUsage {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @db.Uuid
  day    DateTime @db.Date
  count  Int      @default(0)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model Calculation {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  sectionId String?  @db.Uuid
  label     String   @db.VarChar(60)
  title     String   @db.VarChar(300)
  note      String?  @db.VarChar(500)
  variables Json     @default("[]")
  steps     Json     @default("[]")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([projectId, label])
  @@index([projectId])
  @@index([sectionId])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  type      String   @db.VarChar(40)
  projectId String?  @db.Uuid
  // Short facts such as a project title or the number of pages. Never the text a student wrote.
  meta      Json?
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}
